---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/navbar.astro";
import Footer from "../components/footer.astro";
import fs from "node:fs";
import path from "node:path";

export async function getStaticPaths() {
    const articles = await Astro.glob("../content/news/*.md");

    return articles.map((article) => {
        const slug = article.frontmatter.url;

        return {
            params: { article: slug },
            props: { article },
        };
    });
}

const { article } = Astro.props;
const { Content, frontmatter } = article;

let galleryImages = [];
if (frontmatter.galleryFolder) {
    try {
        const publicDir = path.join(process.cwd(), "public");
        const folderPath = frontmatter.galleryFolder.startsWith("/")
            ? frontmatter.galleryFolder.slice(1)
            : frontmatter.galleryFolder;

        const galleryPath = path.join(publicDir, folderPath);

        if (fs.existsSync(galleryPath)) {
            const files = fs.readdirSync(galleryPath);
            galleryImages = files
                .filter((file) => /\.(png|jpe?g|gif|svg|webp)$/i.test(file))
                .map(
                    (file) =>
                        `${frontmatter.galleryFolder.endsWith("/") ? frontmatter.galleryFolder : frontmatter.galleryFolder + "/"}${file}`,
                );
        }
    } catch (e) {
        console.error("Error loading gallery:", e);
    }
}

const allArticles = await Astro.glob("../content/news/*.md");

const recommendedArticles = allArticles
    .filter((a) => a.frontmatter.url !== frontmatter.url)
    .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime())
    .slice(0, 3)
    .map((a) => ({
        title: a.frontmatter.title || "Untitled",
        desc: a.frontmatter.description || "No description provided.",
        img: a.frontmatter.thumbImage,
        url: `/${a.frontmatter.url}`,
    }));

// Format the date properly if it exists
const dateObj = frontmatter.date ? new Date(frontmatter.date) : new Date();
const formattedDate = dateObj.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
});
---

<Layout>
    <Navbar />
    <main class="article-page">
        <div class="article-container">
            <!-- Main Column -->
            <div class="main-column">
                <article>
                    <header class="article-header">
                        <span class="article-date">{formattedDate}</span>
                        <h1 class="article-title">{frontmatter.title}</h1>
                        <div class="article-hero-image">
                            {
                                frontmatter.thumbImage ? (
                                    <img
                                        src={frontmatter.thumbImage}
                                        alt={frontmatter.title}
                                        class="hero-img-element"
                                    />
                                ) : (
                                    <div class="placeholder-img" />
                                )
                            }
                        </div>
                    </header>

                    <div class="article-content">
                        <!-- This renders the markdown content directly! -->
                        <Content />
                    </div>

                    {
                        frontmatter.galleryFolder &&
                            galleryImages.length > 0 && (
                                <section class="gallery-section">
                                    <h2 class="gallery-heading">Gallery</h2>
                                    <div class="gallery-grid">
                                        {galleryImages.map((imgSrc) => (
                                            <div class="gallery-item">
                                                <img
                                                    src={imgSrc}
                                                    alt="Gallery Image"
                                                    class="gallery-img-element"
                                                />
                                            </div>
                                        ))}
                                    </div>
                                </section>
                            )
                    }
                </article>
            </div>

            <!-- Sidebar -->
            <aside class="sidebar-column">
                <h3 class="sidebar-heading">Also Check</h3>
                <div class="related-articles">
                    {
                        recommendedArticles.map((relArticle) => (
                            <div class="related-card">
                                <div class="related-img-wrapper">
                                    {relArticle.img ? (
                                        <img src={relArticle.img} alt={relArticle.title} class="related-img-element" />
                                    ) : (
                                        <div class="placeholder-img" />
                                    )}
                                </div>
                                <div class="related-content">
                                    <h4 class="related-title">
                                        {relArticle.title}
                                    </h4>
                                    <p class="related-desc">
                                        {relArticle.desc}
                                    </p>
                                    <a href={relArticle.url} class="read-more">
                                        Read More ↗
                                    </a>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </aside>
        </div>
    </main>
    <Footer />
</Layout>

<style>
    .article-page {
        padding: 40px var(--page-padding-horizontal);
        max-width: 1400px;
        margin: 0 auto;
    }

    .article-container {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 60px;
    }

    /* Main Column Styles */
    .article-header {
        margin-bottom: 40px;
    }

    .article-date {
        font-family: font2;
        color: var(--accent1);
        font-weight: bold;
        text-transform: uppercase;
        font-size: 14px;
        letter-spacing: 1px;
    }

    .article-title {
        font-family: font1;
        font-size: var(--font-size-heading);
        line-height: 1.1;
        margin: 15px 0 30px 0;
    }

    .article-hero-image {
        width: 100%;
        height: 400px;
        border-radius: 20px;
        overflow: hidden;
        margin-bottom: 40px;
        background: linear-gradient(to bottom right, #ddd, #999);
    }

    .hero-img-element {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .placeholder-img {
        width: 100%;
        height: 100%;
        background: linear-gradient(to bottom right, #ddd, #999);
    }

    .article-content {
        font-family: font2;
        color: var(--text-paragraph);
        font-size: 18px;
        line-height: 1.6;
        margin-bottom: 60px;
    }

    .article-content :global(p) {
        margin-bottom: 20px;
    }

    .article-content :global(h1),
    .article-content :global(h2),
    .article-content :global(h3) {
        font-family: font1;
        color: var(--text-headline);
        margin: 40px 0 20px 0;
    }

    .article-content :global(h1) {
        font-size: 36px;
    }
    .article-content :global(h2) {
        font-size: 32px;
    }

    /* Gallery Styles */
    .gallery-section {
        margin-top: 60px;
        padding-top: 40px;
        border-top: 1px solid var(--divider-color);
    }

    .gallery-heading {
        font-family: font1;
        font-size: 36px;
        margin-bottom: 30px;
    }

    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(
            3,
            1fr
        ); /* TODO: establish a number of images to be displayed */
        gap: 20px;
    }

    .gallery-item {
        height: 250px;
        border-radius: 15px;
        overflow: hidden;
    }

    .gallery-img-element {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Sidebar Styles */
    .sidebar-heading {
        font-family: font1;
        font-size: 32px;
        margin-bottom: 30px;
        padding-bottom: 15px;
        border-bottom: 1px solid var(--divider-color);
    }

    .related-articles {
        display: flex;
        flex-direction: column;
        gap: 30px;
    }

    .related-card {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .related-img-wrapper {
        width: 100%;
        height: 180px;
        border-radius: 15px;
        overflow: hidden;
    }

    .related-img-element {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .related-title {
        font-family: font2;
        font-weight: bold;
        font-size: 20px;
        margin: 0 0 10px 0;
        color: var(--text-headline);
    }

    .related-desc {
        font-family: font2;
        color: var(--text-paragraph);
        font-size: 15px;
        margin: 0 0 15px 0;
    }

    .read-more {
        font-family: font2;
        font-weight: bold;
        color: var(--accent1);
        text-decoration: none;
        transition: color 0.2s;
    }

    .read-more:hover {
        color: var(--accent3);
    }

    /* Responsive Design */
    @media (max-width: 1024px) {
        .article-container {
            grid-template-columns: 1fr;
            gap: 40px;
        }

        .article-hero-image {
            height: 300px;
        }

        .related-card {
            flex-direction: row;
            align-items: center;
        }

        .related-img-wrapper {
            width: 150px;
            height: 100px;
            flex-shrink: 0;
        }
    }

    @media (max-width: 768px) {
        .article-page {
            padding-top: 20px;
        }

        .article-title {
            font-size: var(--font-size-heading);
        }

        .gallery-grid {
            grid-template-columns: repeat(
                2,
                1fr
            ); /* TODO: establish a number of images to be displayed */
        }

        .related-card {
            flex-direction: column;
            align-items: stretch;
        }

        .related-img-wrapper {
            width: 100%;
            height: 180px;
        }
    }
</style>
